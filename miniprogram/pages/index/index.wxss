/** miniprogram/pages/index/index.wxss **/

.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #FFF9E6;
}

/* 画布撑满屏幕 */
.game-canvas {
  width: 100vw;
  height: 100vh;
  display: block;
}

/* 顶部 HUD 容器 */
.hud-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 20;
}

/* 第一层：状态与操作栏 (水平垂直对齐微信右上角胶囊按钮) */
.hud-top-bar {
  position: absolute;
  left: 20rpx;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  pointer-events: none;
}

.hud-bar-left, .hud-bar-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  pointer-events: auto;
}

/* 顶部小药丸徽章 */
.hud-pill {
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #FFF;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15);
}

.badge-level {
  background: linear-gradient(135deg, #FFA000, #FF6F00);
}

.badge-score {
  background: linear-gradient(135deg, #0288D1, #29B6F6);
}

/* 顶部圆形功能按钮 */
.btn-hud-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #FFF;
  border: 3rpx solid #E0E0E0;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5D4037;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.1s ease;
}

.btn-hud-icon:active {
  transform: scale(0.9);
  background: #F5F5F5;
}

/* 第二层：识字目标任务行 (独占整行，居中宽敞) */
.hud-mission-row {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: auto;
}

.mission-pill {
  background: linear-gradient(135deg, #FF6F00, #FFA000);
  color: #FFF;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 26rpx 6rpx 20rpx;
  border-radius: 46rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 111, 0, 0.35);
  border: 4rpx solid #FFE082;
  white-space: nowrap;
  animation: pulse-border 2.5s infinite;
}

@keyframes pulse-border {
  0%, 100% { border-color: #FFE082; }
  50% { border-color: #FFF9C4; }
}

.mission-pill:active {
  transform: scale(0.96);
  opacity: 0.95;
}

.mission-target-icon {
  font-size: 26rpx;
  font-weight: 900;
  color: #FFF9C4;
}

.mission-char-box {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0 6rpx;
}

.mission-pinyin {
  font-size: 22rpx;
  color: #FFFDE7;
  font-weight: 800;
  margin-bottom: 2rpx;
  letter-spacing: 1rpx;
}

.mission-word {
  font-size: 44rpx;
  font-weight: 900;
  color: #FFF;
  text-shadow: 0 3rpx 6rpx rgba(0, 0, 0, 0.3);
}

.mission-phrase {
  background: rgba(255, 255, 255, 0.28);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #FFF;
}

.mission-speaker-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(0, 0, 0, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
}

.mission-speaker {
  font-size: 26rpx;
}

.mission-speaker-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFDE7;
}

/* 连击浮层 */
.combo-badge {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #FF5252, #FF1744);
  color: #FFF;
  font-size: 28rpx;
  font-weight: 900;
  padding: 6rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 23, 68, 0.45);
  border: 4rpx solid #FFF;
  pointer-events: none;
  z-index: 25;
}

/* 击中大字浮层 */
.big-word-popup {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.6);
  background: rgba(255, 255, 255, 0.96);
  border: 10rpx solid #FFA000;
  border-radius: 48rpx;
  padding: 30rpx 70rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(255, 111, 0, 0.45);
  pointer-events: none;
  opacity: 0;
  transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 100;
}

.big-word-popup.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.big-word-pinyin {
  font-size: 40rpx;
  font-weight: bold;
  color: #E65100;
}

.big-word-char {
  font-size: 150rpx;
  font-weight: 900;
  color: #E65100;
  line-height: 1.1;
}

.big-word-phrase {
  font-size: 34rpx;
  font-weight: bold;
  color: #795548;
}

.big-word-pts {
  font-size: 32rpx;
  font-weight: 900;
  color: #4CAF50;
  margin-top: 8rpx;
}

/* 首页开始界面 */
.start-screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 30%, #FFFDE7 0%, #FFF9C4 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
  padding: 40rpx 30rpx;
  z-index: 30;
}

.title-logo {
  font-size: 72rpx;
  font-weight: 900;
  color: #FF6F00;
  text-shadow: 0 6rpx #FFE082, 0 12rpx 24rpx rgba(255, 111, 0, 0.35);
}

.title-subtitle {
  font-size: 28rpx;
  color: #8D6E63;
  font-weight: bold;
}

.grade-pill-box {
  background: rgba(255, 255, 255, 0.9);
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  width: 90%;
  box-shadow: 0 10rpx 28rpx rgba(255, 179, 0, 0.25);
  text-align: center;
}

.grade-label {
  font-size: 24rpx;
  font-weight: bold;
  color: #6D4C41;
  margin-bottom: 16rpx;
}

.grade-btn-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.btn-grade {
  background: #F5F5F5;
  border: 3rpx solid #E0E0E0;
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  color: #757575;
}

.btn-grade.active {
  background: #FFA000;
  color: #FFF;
  border-color: #FF6F00;
  box-shadow: 0 4rpx 12rpx rgba(255, 160, 0, 0.4);
}

.grade-tip-text {
  font-size: 22rpx;
  color: #8D6E63;
  margin-top: 14rpx;
  font-weight: bold;
}

.btn-start-huge {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  color: #FFF;
  font-size: 48rpx;
  font-weight: 900;
  padding: 22rpx 90rpx;
  border-radius: 60rpx;
  border: 6rpx solid #A5D6A7;
  box-shadow: 0 12rpx 32rpx rgba(56, 142, 60, 0.45);
}

.btn-start-huge:active {
  transform: scale(0.95);
}

.start-nav-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-sub {
  color: #FFF;
  font-size: 24rpx;
  font-weight: bold;
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

.btn-sub:active {
  transform: scale(0.94);
}

.bg-orange { background: #FF9800; }
.bg-amber { background: #FFA000; }
.bg-blue { background: #42A5F5; }
.bg-brown { background: #8D6E63; }

/* 模态弹窗蒙层与卡片 */
.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.card {
  background: #FFF;
  border-radius: 40rpx;
  padding: 36rpx 30rpx;
  width: 86%;
  max-height: 85vh;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  overflow-y: auto;
}

.modal-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 42rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #795548;
  margin-bottom: 20rpx;
}

.color-orange { color: #E65100; }
.color-amber { color: #FFA000; }
.color-blue { color: #1976D2; }
.color-green { color: #4CAF50; }
.color-red { color: #F44336; }
.bold { font-weight: bold; }

.btn-main {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  color: #FFF;
  font-size: 32rpx;
  font-weight: 900;
  padding: 18rpx 50rpx;
  border-radius: 40rpx;
  margin: 16rpx auto;
  box-shadow: 0 8rpx 20rpx rgba(56, 142, 60, 0.35);
  display: inline-block;
}

.btn-close {
  background: #EEE;
  color: #666;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  display: inline-block;
  margin-top: 16rpx;
}

/* 关卡汉字导读卡片弹窗 */
.intro-card-modal {
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  padding: 30rpx 24rpx 20rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.intro-modal-header {
  flex-shrink: 0;
}

.intro-cards-scroll-wrapper {
  max-height: 50vh;
  margin: 12rpx 0;
  width: 100%;
}

.intro-cards-container {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 8rpx 4rpx;
}

.intro-word-card {
  background: #FFF3E0;
  border: 4rpx solid #FFE082;
  border-radius: 24rpx;
  padding: 14rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 14rpx rgba(255, 179, 0, 0.2);
  min-width: 130rpx;
  flex: 0 0 auto;
}

.intro-pinyin {
  font-size: 22rpx;
  color: #E65100;
  font-weight: bold;
}

.intro-char {
  font-size: 56rpx;
  font-weight: 900;
  color: #E65100;
  line-height: 1.1;
  margin: 4rpx 0;
}

.intro-phrase {
  font-size: 22rpx;
  color: #795548;
  font-weight: bold;
}

.intro-modal-footer {
  flex-shrink: 0;
  padding-top: 14rpx;
  border-top: 2rpx dashed rgba(255, 160, 0, 0.25);
  width: 100%;
  display: flex;
  justify-content: center;
}

.btn-start-intro {
  margin: 0 !important;
}

/* 结算弹窗星级与回顾 */
.win-card-modal {
  width: 90vw !important;
  max-width: 600rpx !important;
  padding: 30rpx 24rpx 24rpx !important;
  display: flex !important;
  flex-direction: column !important;
  max-height: 88vh !important;
  box-sizing: border-box !important;
}

.win-modal-header {
  flex-shrink: 0;
}

.stars-row {
  font-size: 64rpx;
  margin: 8rpx 0;
  color: #FFD700;
}

.win-summary {
  font-size: 30rpx;
  color: #5D4037;
  font-weight: bold;
}

.win-review-box {
  background: #FFF9C4;
  border: 3rpx solid #FFE082;
  border-radius: 24rpx;
  padding: 16rpx 12rpx;
  margin: 14rpx 0;
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  max-height: 40vh;
  box-sizing: border-box;
}

.win-review-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #F57F17;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.win-words-scroll-wrapper {
  max-height: 32vh;
  width: 100%;
}

.win-words-gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  padding: 4rpx;
}

.win-word-chip {
  background: #FFF;
  border: 3rpx solid #FFA000;
  color: #E65100;
  font-size: 40rpx;
  font-weight: 900;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.win-modal-footer {
  flex-shrink: 0;
  padding-top: 10rpx;
  border-top: 2rpx dashed rgba(255, 160, 0, 0.25);
  width: 100%;
}

.btn-continue-huge {
  background: linear-gradient(135deg, #4CAF50, #2E7D32) !important;
  color: #FFF !important;
  font-size: 34rpx !important;
  font-weight: 900 !important;
  padding: 20rpx 60rpx !important;
  border-radius: 50rpx !important;
  box-shadow: 0 10rpx 26rpx rgba(56, 142, 60, 0.45) !important;
  margin: 10rpx auto 14rpx !important;
  display: block !important;
}

.btn-continue-huge:active {
  transform: scale(0.96);
}

.win-actions-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

/* 我的识字本 */
.book-card-container {
  width: 90%;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.book-counter {
  font-size: 24rpx;
  color: #8D6E63;
  margin-top: 4rpx;
}

.book-grade-group {
  margin: 14rpx 0;
}

.book-grid {
  height: 52vh;
  width: 100%;
}

.book-char-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFF;
  border: 3rpx solid #E0E0E0;
  border-radius: 20rpx;
  width: 140rpx;
  height: 160rpx;
  margin: 8rpx;
  position: relative;
  vertical-align: top;
}

.book-char-card.mastered {
  background: #FFF9C4;
  border-color: #FFA000;
}

.book-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  background: #4CAF50;
  color: #FFF;
  font-size: 18rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-pinyin {
  font-size: 20rpx;
  color: #8D6E63;
}

.book-char {
  font-size: 52rpx;
  font-weight: 900;
  color: #E65100;
  line-height: 1.1;
}

.book-phrase {
  font-size: 18rpx;
  color: #795548;
}

/* 怪兽图鉴 */
.monster-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 20rpx 0;
}

.monster-card {
  background: #F5F5F5;
  border-radius: 24rpx;
  padding: 16rpx 10rpx;
  border: 3rpx solid #E0E0E0;
}

.monster-card.locked {
  opacity: 0.5;
  filter: grayscale(1);
}

.monster-icon {
  font-size: 56rpx;
}

.monster-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #5D4037;
  margin: 4rpx 0;
}

.monster-desc {
  font-size: 18rpx;
  color: #8D6E63;
}

/* 家长门禁 */
.gate-question {
  font-size: 36rpx;
  font-weight: bold;
  color: #E65100;
  margin: 24rpx 0;
}

.gate-opts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-gate-opt {
  background: #E3F2FD;
  border: 4rpx solid #90CAF9;
  border-radius: 24rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #1976D2;
  padding: 18rpx;
}

/* 家长学习看板 */
.parent-card-container {
  width: 92%;
  max-height: 88vh;
}

.parent-retention-box {
  background: #E8F5E9;
  border: 2rpx solid #A5D6A7;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin: 14rpx 0;
  text-align: left;
}

.parent-retention-rate {
  font-weight: bold;
  color: #2E7D32;
  font-size: 26rpx;
}

.parent-retention-tip {
  font-size: 20rpx;
  color: #555;
  margin-top: 6rpx;
}

.parent-summary-text {
  font-size: 22rpx;
  color: #5D4037;
  margin: 10rpx 0;
}

.stats-table-scroll {
  max-height: 40vh;
  margin: 14rpx 0;
}

.stats-table {
  width: 100%;
}

.stats-tr {
  display: flex;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #EEE;
  font-size: 22rpx;
  align-items: center;
}

.stats-th {
  background: #FFF3E0;
  color: #E65100;
  font-weight: bold;
}

.stats-td {
  flex: 1;
  text-align: center;
}
